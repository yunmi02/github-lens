# Copy to .env in the repository root. Never commit credentials.
DATABASE_URL=sqlite:///./data/github-lens.db
DATA_DIR=./data
# Optional: configure before first start, otherwise set a password from localhost.
ADMIN_PASSWORD=
COOKIE_SECURE=false
# Set to http://YOUR_LAN_IP:8000 for phone access, or your HTTPS domain.
PUBLIC_BASE_URL=
GITHUB_TOKEN=
OCR_PROVIDER=paddle
OCR_LANG=ch
# An optional chat-completions-compatible provider for Chinese summaries.
# Ordinary OCR stays local. The research agent sends pending screenshots to this provider.
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=
AI_DAILY_LIMIT=100
AGENT_AUTO_RESEARCH=true
AGENT_AUTO_CONFIRM=true
# browser: persistent isolated Chrome; computer_use: authorized desktop session only.
RESEARCH_BACKEND=browser
BROWSER_SERVICE_ENABLED=true
BROWSER_CHANNEL=chrome
BROWSER_HEADLESS=true
BROWSER_REQUEST_INTERVAL_SECONDS=15
BROWSER_SEARCH_INTERVAL_SECONDS=30
BROWSER_COOLDOWN_SECONDS=900
BROWSER_MAX_COOLDOWN_SECONDS=21600
COMPUTER_USE_LEASE_SECONDS=900
AGENT_SEARCH_DAILY_LIMIT=50
# Optional for a proxy; official api.deepseek.com works without this setting.
AI_SEARCH_BASE_URL=
